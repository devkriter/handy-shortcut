// The settings window, in Slint's Fluent style (follows the Windows light/dark
// setting). Compact layout: one header row (status, level, Save, Start/Stop),
// two columns of cards, and the activity list filling the rest. All behaviour
// lives in src/app.rs; this file only binds properties and forwards callbacks.

import { Button, CheckBox, ComboBox, LineEdit, ListView, Palette, ProgressIndicator,
         SpinBox, Switch } from "std-widgets.slint";

export struct LogLine {
    time: string,
    text: string,
    // 0 info, 1 button down, 2 button up, 3 ignored, 4 extra, 5 error
    kind: int,
}

// Windows 11 surface colours; Palette covers the controls.
global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> window-bg: dark ? #202020 : #f3f3f3;
    out property <color> card-bg: dark ? #2b2b2b : #fbfbfb;
    out property <color> card-border: dark ? #1c1c1c : #e5e5e5;
    out property <color> secondary: dark ? #c5c5c5 : #616161;
    out property <color> green: dark ? #6ccb5f : #0f7b0f;
    out property <color> blue: dark ? #60cdff : #005fb8;
    out property <color> orange: dark ? #fce100 : #9d5d00;
    out property <color> red: dark ? #ff99a4 : #c42b1c;
    out property <color> grey: dark ? #9d9d9d : #8a8a8a;
    out property <length> label-width: 92px;
}

component Card inherits Rectangle {
    in property <string> title;
    // Optional button at the right of the title.
    in property <string> action;
    callback action-clicked();
    background: Theme.card-bg;
    border-color: Theme.card-border;
    border-width: 1px;
    border-radius: 8px;

    VerticalLayout {
        padding: 12px;
        padding-top: 10px;
        spacing: 8px;
        HorizontalLayout {
            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.action != "": Button {
                text: root.action;
                clicked => { root.action-clicked(); }
            }
        }
        @children
    }
}

// A label on the left, controls on the right.
component Row inherits HorizontalLayout {
    in property <string> label;
    spacing: 8px;
    Text {
        text: root.label;
        width: Theme.label-width;
        vertical-alignment: center;
    }
    @children
}

export component AppWindow inherits Window {
    title: "Handy Shortcut";
    background: Theme.window-bg;
    preferred-width: 780px;
    preferred-height: 600px;
    min-width: 720px;

    // status
    in property <string> status-text: "Stopped";
    // 0 stopped, 1 listening, 2 button down, 3 waiting for the mic
    in property <int> status-kind;
    in property <bool> listening;
    in property <float> level;
    in property <string> level-text;

    // form
    in-out property <string> hotkey;
    in property <bool> recording;
    in property <[string]> modes;
    in-out property <int> mode-index;
    in-out property <bool> enter-after;
    in-out property <int> enter-delay;
    in property <[string]> devices;
    in-out property <int> device-index;
    in-out property <int> channel;
    in-out property <bool> invert;
    in-out property <bool> autostart;
    in-out property <bool> startup;
    in-out property <string> peak-min;
    in-out property <string> width-ms;
    in property <bool> dirty;
    in property <string> form-error;

    in property <[LogLine]> log;

    callback toggle-listening();
    callback record();
    callback refresh-devices();
    callback save();
    // A text or number field changed: just update the Save button.
    callback form-edited();
    // A checkbox, switch or dropdown changed: apply right away.
    callback apply-now();
    callback startup-toggled(bool);
    callback open-log();

    public function scroll-log-to-end() {
        log-view.content-y = min(0px, log-view.visible-height - log-view.content-height);
    }

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // ---- header: status, level, save, start/stop ----------------------
        HorizontalLayout {
            spacing: 12px;
            Rectangle {
                width: 12px;
                height: 12px;
                y: (parent.height - self.height) / 2;
                border-radius: 6px;
                background: root.status-kind == 1 ? Theme.green
                    : root.status-kind == 2 ? Theme.orange
                    : root.status-kind == 3 ? Theme.red
                    : Theme.grey;
            }
            Text {
                text: root.status-text;
                font-size: 20px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                ProgressIndicator { width: 140px; height: 4px; progress: root.level; }
            }
            Text {
                text: root.level-text;
                width: 60px;
                horizontal-alignment: right;
                vertical-alignment: center;
                color: Theme.secondary;
                font-size: 12px;
            }
            Button {
                text: "Save";
                primary: root.dirty;
                enabled: root.dirty;
                width: 80px;
                clicked => { root.save(); }
            }
            Button {
                text: root.listening ? "Stop" : "Start";
                primary: !root.listening && !root.dirty;
                width: 80px;
                clicked => { root.toggle-listening(); }
            }
        }

        if root.form-error != "": Text {
            text: root.form-error;
            color: Theme.red;
            wrap: word-wrap;
        }

        // ---- settings, two columns -----------------------------------------
        HorizontalLayout {
            spacing: 12px;

            VerticalLayout {
                spacing: 12px;
                horizontal-stretch: 1;
                alignment: start;

                Card {
                    title: "Shortcut";
                    Row {
                        label: "Keys";
                        LineEdit {
                            text <=> root.hotkey;
                            read-only: root.recording;
                            placeholder-text: "e.g. ctrl+space";
                            edited => { root.form-edited(); }
                            accepted => { root.save(); }
                        }
                        Button {
                            text: root.recording ? "Cancel" : "Record";
                            width: 76px;
                            clicked => { root.record(); }
                        }
                    }
                    Row {
                        label: "Action";
                        ComboBox {
                            model: root.modes;
                            current-index <=> root.mode-index;
                            selected => { root.apply-now(); }
                        }
                    }
                    Row {
                        label: "Then";
                        CheckBox {
                            text: "Enter after";
                            checked <=> root.enter-after;
                            toggled => { root.apply-now(); }
                        }
                        SpinBox {
                            value <=> root.enter-delay;
                            minimum: 0;
                            maximum: 10000;
                            step-size: 100;
                            enabled: root.enter-after;
                            width: 104px;
                            edited => { root.form-edited(); }
                        }
                        Text { text: "ms"; vertical-alignment: center; color: Theme.secondary; }
                    }
                }

                Card {
                    title: "Microphone";
                    Row {
                        label: "Input";
                        ComboBox {
                            model: root.devices;
                            current-index <=> root.device-index;
                            selected => { root.apply-now(); }
                        }
                        Button {
                            icon: @image-url("refresh.svg");
                            colorize-icon: true;
                            accessible-label: "Refresh microphones";
                            width: 36px;
                            clicked => { root.refresh-devices(); }
                        }
                    }
                    Row {
                        label: "Channel";
                        SpinBox {
                            value <=> root.channel;
                            minimum: 1;
                            maximum: 32;
                            width: 104px;
                            edited => { root.form-edited(); }
                        }
                        Rectangle { }
                    }
                }
            }

            VerticalLayout {
                spacing: 12px;
                horizontal-stretch: 1;
                alignment: start;

                Card {
                    title: "Startup";
                    Switch {
                        text: "Start listening when the app opens";
                        checked <=> root.autostart;
                        toggled => { root.apply-now(); }
                    }
                    Switch {
                        text: "Start with Windows (in the tray)";
                        checked <=> root.startup;
                        toggled => { root.startup-toggled(self.checked); }
                    }
                }

                Card {
                    title: "Thump detection";
                    Row {
                        label: "Min peak";
                        LineEdit {
                            text <=> root.peak-min;
                            input-type: decimal;
                            width: 64px;
                            edited => { root.form-edited(); }
                            accepted => { root.save(); }
                        }
                        Text { text: "Min width"; vertical-alignment: center; }
                        LineEdit {
                            text <=> root.width-ms;
                            input-type: decimal;
                            width: 64px;
                            edited => { root.form-edited(); }
                            accepted => { root.save(); }
                        }
                        Text { text: "ms"; vertical-alignment: center; color: Theme.secondary; }
                        Rectangle { }
                    }
                    Switch {
                        text: "Swap press and release";
                        checked <=> root.invert;
                        toggled => { root.apply-now(); }
                    }
                    Text {
                        text: "Button thumps: peak 1.00, about 2.7 ms wide.";
                        font-size: 12px;
                        color: Theme.secondary;
                    }
                }
            }
        }

        // ---- activity, fills the rest ---------------------------------------
        Card {
            title: "Activity";
            action: "Open log file";
            action-clicked => { root.open-log(); }
            vertical-stretch: 1;
            min-height: 150px;
            Rectangle {
                vertical-stretch: 1;
                background: Palette.control-background;
                border-color: Theme.card-border;
                border-width: 1px;
                border-radius: 4px;
                clip: true;
                log-view := ListView {
                    for line in root.log: HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 2px;
                        padding-bottom: 2px;
                        spacing: 10px;
                        Text {
                            text: line.time;
                            width: 60px;
                            font-family: "Cascadia Mono";
                            font-size: 12px;
                            color: Theme.secondary;
                        }
                        Text {
                            text: line.text;
                            font-family: "Cascadia Mono";
                            font-size: 12px;
                            overflow: elide;
                            color: line.kind == 1 ? Theme.green
                                : line.kind == 2 ? Theme.blue
                                : line.kind == 3 ? Theme.grey
                                : line.kind == 4 ? Theme.orange
                                : line.kind == 5 ? Theme.red
                                : Palette.foreground;
                        }
                    }
                }
            }
        }
    }
}
